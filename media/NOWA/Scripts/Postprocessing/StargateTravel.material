//---------------------------------------------------
// Stargate Travel — Wormhole Tunnel Effect
//
// elapsedTime is an auto-param — Ogre updates it every frame for free.
// startTimeSeconds is pushed ONCE when startTravel() is called.
// durationSeconds, aspectRatio, tunnelColor etc. pushed once at postInit.
//
// Zero per-frame C++ GPU pushes. Zero closures in update().
//---------------------------------------------------

fragment_program StargateTravel_ps_GLSL glsl
{
    source StargateTravel_ps.glsl
    default_params
    {
        param_named RT int 0
    }
}
fragment_program StargateTravel_ps_VK glslvk
{
    source StargateTravel_ps.glsl
    default_params
    {
        param_named RT int 0
    }
}
fragment_program StargateTravel_ps_HLSL hlsl
{
    source StargateTravel_ps.hlsl
    target ps_5_0 ps_4_0 ps_4_0_level_9_1 ps_4_0_level_9_3
    entry_point main
}
fragment_program StargateTravel_ps_Metal metal
{
    source StargateTravel_ps.metal
    shader_reflection_pair_hint Ogre/Compositor/Quad_vs
}
fragment_program StargateTravel_ps unified
{
    delegate StargateTravel_ps_HLSL
    delegate StargateTravel_ps_GLSL
    delegate StargateTravel_ps_VK
    delegate StargateTravel_ps_Metal
}

material Postprocess/StargateTravel
{
    technique
    {
        pass
        {
            depth_check off
            depth_write off
            cull_hardware none

            vertex_program_ref Ogre/Compositor/Quad_vs {}

            fragment_program_ref StargateTravel_ps
            {
                // ---- Auto-param: Ogre updates this every frame, zero C++ work ----
                param_named_auto elapsedTime time 1.0

                // ---- Pushed ONCE on startTravel() — large sentinel = not started ----
                param_named startTimeSeconds  float  1e10

                // ---- Pushed ONCE at postInit / variant change ----
                param_named durationSeconds   float  3.5
                param_named aspectRatio       float  1.7778

                param_named tunnelColor       float3  0.1 0.4 0.9
                param_named ringFrequency     float   8.0
                param_named ringSpeed         float   6.0
                param_named distortionStrength float  1.0
                param_named brightness        float   1.2
            }

            texture_unit
            {
                tex_address_mode clamp
                filtering bilinear
            }
        }
    }
}
