	workflow specular_ogre
	brdf default_separate_diffuse_fresnel

	diffuse 1 1 1
	diffuse_map carrotD.png
	specular 1 1 1
	fresnel 0.05
	normal_map carrotN.dds
	roughness 0.1
}

