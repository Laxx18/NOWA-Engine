// Swaying Wind HLMS variants for twig/leaf submeshes identified by
// isLeavesSubMesh() via the "twig" and "peacock" name patterns added
// alongside the existing "leaf"/"leaves" patterns.
//
// NAMING CONVENTION: original datablock name + literal "Swaying" suffix,
// no other transformation. E.g. "tree16tallTwig" -> "tree16tallTwigSwaying".
// Matches ProceduralFoliageVolumeComponent::getSwayingDatablockName exactly.
//
// The 16 leaf/leaves entries from tree_material.json already exist in
// SwayingTreeLeavesMaterials.material -- only the 48 new twig entries
// are generated here to avoid duplication.
//
// alpha_hash used uniformly (same reasoning as SwayingTreeLeavesMaterials.material).
// Values extracted programmatically from tree_material.json to avoid
// transcription errors.

hlms /dural/plants/fruit/acorn/texture/leafSwaying Wind
{
	cull_mode none
	alpha_hash yes

	workflow specular_ogre
	brdf default_separate_diffuse_fresnel

	diffuse 1 1 1
	diffuse_map acornD.png
	normal_map acornN.dds
	roughness 0.7
}

hlms /dural/plants/fruit/carrot/leafSwaying Wind
{
	cull_mode none
